[Unit]
Description=MiniMax-M2.7 OpenAI/Anthropic API server (v6e-64, per-host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kathirks_gc
Group=kathirks_gc
WorkingDirectory=/home/kathirks_gc/maxtext
Environment=HOME=/home/kathirks_gc
Environment=DTMPFS_ROOT=/mnt/dtmpfs
Environment=MAXTEXT_SERVER_PORT=8000
Environment=MAXTEXT_SERVER_HOST=0.0.0.0
# Set MAXTEXT_API_KEY in a drop-in file (e.g. /etc/systemd/system/minimax-m2-serve-v6e64.service.d/auth.conf)
# Per the no-GCS constraint we DO NOT call reload_from_gcs.sh here.

ExecStartPre=/usr/bin/bash -lc 'mountpoint -q /mnt/dtmpfs || { echo "dtmpfs not mounted; run setup_dtmpfs.sh once at boot"; exit 1; }'
ExecStartPre=/usr/bin/bash -lc 'ls -1 /mnt/dtmpfs/minimax-m2.7-npy-distributed/manifest.p*.json >/dev/null 2>&1 || { echo "distributed manifest missing on this worker"; exit 1; }'

ExecStart=/usr/bin/bash -lc 'bash /home/kathirks_gc/maxtext/scripts/minimax_m2.7/serve_v6e_64.sh'

# Health-gate on /ready returning 200. Cold first compile takes ~10-15 min.
ExecStartPost=/usr/bin/bash -lc 'for i in $(seq 1 240); do curl -fsS http://127.0.0.1:8000/ready >/dev/null 2>&1 && exit 0; sleep 5; done; exit 1'

LimitMEMLOCK=infinity
LimitNOFILE=65536
Restart=on-failure
RestartSec=30
TimeoutStartSec=1800

StandardOutput=append:/home/kathirks_gc/minimax-m2-serve-v6e64.service.log
StandardError=append:/home/kathirks_gc/minimax-m2-serve-v6e64.service.log

[Install]
WantedBy=multi-user.target
